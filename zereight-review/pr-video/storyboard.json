      {"kind": "ctx", "text": "pub fn build_manifest(repo: &str, base: &str, head: &str) -> io::Result<Manifest> {"},
      {"kind": "add", "text": "    let range = format!(\"{base}...{head}\");"},
      {"kind": "ctx", "text": "    let status_out = Command::new(\"git\")"},
      {"kind": "add", "text": "        .args([\"diff\", &range, \"--name-status\", \"-z\"])"},
      {"kind": "ctx", "text": "    let diff_out = Command::new(\"git\")"},
      {"kind": "add", "text": "        .args([\"diff\", &range, \"-U0\", \"--no-color\"])"},
      {"kind": "ctx", "text": "    let parsed = parse_diff(&String::from_utf8_lossy(&diff_out.stdout));"},
      {"kind": "add", "text": "    Ok(Manifest { version: 1, base: base.to_string(), head: head.to_string(), files, scopes, bundles })"}
