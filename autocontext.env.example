# Copy to shell profile or: set -a; source autocontext.env.example; set +a
# Pi + autocontext — skill repo defaults

AUTOCONTEXT_AGENT_PROVIDER=pi
AUTOCONTEXT_PI_COMMAND=pi

AUTOCONTEXT_DB_PATH=runs/autocontext.sqlite3
AUTOCONTEXT_RUNS_ROOT=runs
AUTOCONTEXT_KNOWLEDGE_ROOT=knowledge
AUTOCONTEXT_EVENT_STREAM_PATH=runs/events.ndjson

# Keep loops cheap until you trust the rubric
AUTOCONTEXT_DEFAULT_GENERATIONS=2
